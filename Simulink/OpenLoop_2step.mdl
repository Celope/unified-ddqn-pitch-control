<?xml version="1.0" encoding="utf-8"?>
<chart id="48">
  <P Name="name">MATLAB Function4</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">48</P>
  <P Name="visible">1</P>
  <subviewS/>
  <P Name="ssIdHighWaterMark">8</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">5</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">pitchrate</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">48</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function y = pitchrate(t,w,e)
% Pitch-rate scaling factor kappa_t.
% Nominal pitch rate = kappa * 0.4 deg/s (Delta_beta = 0.010 deg, Ts = 0.025 s).
%   t : simulation time [s]
%   w : hub-height wind speed [m/s] (unused)
%   e : power tracking error P_rated - P_out [W]
% --- Run settings (see README, Section 8) ----------------------------
    SAW10 = false;  % true only for the 10 m/s sawtooth profile
    MODE  = 1;      % 0 = fixed rate, 1 = two-level adaptive rule (0.8/0.3 deg/s)
    KFIX  = 1;      % fixed kappa (used only when MODE = 0)
% ---------------------------------------------------------------------
    % Start-up (excluded from the metrics, which use 200-5200 s)
    if SAW10
        if t &lt; 50
            y = 1;  return      % 0.4 deg/s
        end
    else
        if t &lt; 10
            y = 10;  return     % 4 deg/s
        elseif t &lt; 15
            y = 5;   return     % 2 deg/s
        elseif t &lt; 200
            y = 2.5; return     % 1 deg/s
        end
    end
    % Configuración evaluada
    if MODE == 1
        if abs(e) &gt; 0.1e6
            y = 2;      % 0.8 deg/s
        else
            y = 0.75;   % 0.3 deg/s
        end
    else
        y = KFIX;
    end
end</P>
      </eml>
    </state>
    <data SSID="4" name="t">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="y">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="6" name="w">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="7" name="e">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
