<?xml version="1.0" encoding="utf-8"?>
<chart id="67">
  <P Name="name">MATLAB Function5</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">67</P>
  <P Name="visible">1</P>
  <subviewS/>
  <P Name="ssIdHighWaterMark">7</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">7</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">offset</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">67</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function y = offset(t,w,e)
% Pitch offset for the diagnostic test of the transition profile (Section 6.2).
%   t : simulation time [s]
%   w : hub-height wind speed [m/s]
%   e : power tracking error [W] (unused)
% Default: no offset (k = 0), used for all results except the diagnostic test.
% Diagnostic test (10 m/s sawtooth, kappa = 0.01):
%   k = -1*pi/180 for t &gt; 51 s and w &lt; 9.8 m/s (rated wind speed).
    if t &lt; 10
        k = 0;     
    elseif t &lt; 15
        k = 0;     
    elseif t &lt; 51
        k = 0;    
    elseif t &gt; 51 &amp;&amp; w &lt; 9.8
        k = 0*pi/180 ; %-1*pi/180;
    else
        k = 0*pi/180 ;
    end
    y = k;
end</P>
      </eml>
    </state>
    <data SSID="4" name="t">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="y">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="6" name="w">
      <P Name="scope">INPUT_DATA</P>
      <props>
