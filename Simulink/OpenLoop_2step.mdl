<?xml version="1.0" encoding="utf-8"?>
<chart id="33">
  <P Name="name">Recompensa</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">33</P>
  <P Name="ssIdHighWaterMark">23</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">3</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fcn</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">33</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function y = fcn(p,TSR, w,pitch,pot_error,w_error,RootMyb1 , TwrBsMyt, wind)
    % --- Constantes ---
    p_rated   = 3370000;     % [W]
    TSR_opt   = 8.02;
    w_rated = 1.21;
    omega_lim = [3 13]*pi/30;
    pitch_lim = [0 30]*pi/180;%0-30°
    TSR_lim = [3 9];
    % --- Limites de momentos ---
    M_root_max = 6000;   M_root_min = 0;   dM_root = M_root_max - M_root_min;%KNM
    M_twr_max  = 40000;  M_twr_min  = 0; dM_twr  = M_twr_max  - M_twr_min; %KNM
    
    % --- Recompensa ---
    if wind &gt;= 9.5
        r_pow = 0.5*min(1,p / p_rated) + 0.5*min(1,w/w_rated);
    else
        r_pow = 1*min(1,TSR /  TSR_opt)   ; 
    end
    % --- Castigo por violar límites ---
    r_punishment = 0;
    
    if any([w&lt;omega_lim(1), w&gt;omega_lim(2), ...
             pitch&lt;pitch_lim(1), pitch&gt;pitch_lim(2), ...
        TSR&lt;TSR_lim(1), TSR&gt;TSR_lim(2)])
         r_punishment = -3;  
    end


    % Normalizar error respecto a la potencia nominal
   
    if wind &gt;= 9.5
         r_error = -(abs(pot_error) / p_rated)^1 - (abs(w_error) / w_rated)^1;  % más negativo si el error es grande
    else
         r_error = -abs(TSR -  TSR_opt) /  TSR_opt;
    end    

    y = r_pow + r_punishment + r_error ;
end


    % 
    % exc_root = max(0, RootMyb1 - M_root_max)/dM_root + max(0, M_root_min - RootMyb1)/dM_root;
    % exc_twr  = max(0, TwrBsMyt - M_twr_max)/dM_twr  + max(0, M_twr_min - TwrBsMyt)/dM_twr;
    % r_root=-exc_root;
    % r_twr=-exc_twr;
% % --- Constantes ---
% p_rated   = 3370000;     % [W]
% TSR_rated   = 8.02;
% w_rated = 1.21;
% omega_lim = [3 13]*pi/30;
% pitch_lim = [0 30]*pi/180;%0-30°
% TSR_lim = [3 9];
% % --- Limites de momentos ---
% M_root_max = 6000;   M_root_min = 2000;   dM_root = M_root_max - M_root_min;%KNM
% M_twr_max  = 40000;  M_twr_min  = 20000; dM_twr  = M_twr_max  - M_twr_min; %KNM
% 
% % --- Recompensa ---
% r_pow = 0.5*min(1,p / p_rated) + 0.5*min(1,w/w_rated);
% 
% % --- Castigo por violar límites ---
% r_punishment = 0;
% 
% if any([w&lt;omega_lim(1), w&gt;omega_lim(2), ...
%          pitch&lt;pitch_lim(1), pitch&gt;pitch_lim(2), ...
%     TSR&lt;TSR_lim(1), TSR&gt;TSR_lim(2)])
%      r_punishment = -3;  
% end
% 
% % Normalizar error respecto a la potencia nominal
% r_error = -abs(pot_error) / p_rated - abs(w_error) / w_rated;  % más negativo si el error es grande
% 
% exc_root = max(0, RootMyb1 - M_root_max)/dM_root + max(0, M_root_min - RootMyb1)/dM_root;
% exc_twr  = max(0, TwrBsMyt - M_twr_max)/dM_twr  + max(0, M_twr_min - TwrBsMyt)/dM_twr;
% r_root=-exc_root;
% r_twr=-exc_twr;
% 
% 
% y = r_pow + r_punishment + r_error + 0*r_root;








</P>
        <P Name="vectorOutputs1D">1</P>
      </eml>
    </state>
    <data SSID="5" name="y">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="6" name="p">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="11" name="TSR">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
